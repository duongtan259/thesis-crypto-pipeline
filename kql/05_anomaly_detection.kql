// ════════════════════════════════════════════════════════════════
// ANOMALY DETECTION — Price changes and rolling-volume-snapshot changes
// Runs on top of price_silver
// Run after 02_silver.kql
// ════════════════════════════════════════════════════════════════

// Alert table: stores triggered alerts
.create-merge table price_alerts (
    alert_id:       string,
    symbol:         string,
    alert_type:     string,    // "PRICE_SPIKE" | "PRICE_DROP"
    triggered_at:   datetime,
    price_before:   real,
    price_after:    real,
    change_pct:     real,
    window_seconds: int,
    severity:       string     // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
)

// Function: detect price spikes > threshold% within a window
// Usage: DetectPriceSpikes(2.0, 60s)  -- >2% move in 60 seconds
.create-or-alter function DetectPriceSpikes(threshold_pct: real = 2.0, window: timespan = 60s) {
    price_silver
    | where timestamp_utc > ago(window)
    | sort by symbol asc, timestamp_utc asc, sequence asc, event_id asc
    | serialize
    | extend
        prev_price  = prev(price_usd, 1),
        prev_symbol = prev(symbol, 1),
        prev_time   = prev(timestamp_utc, 1)
    | where symbol == prev_symbol and timestamp_utc - prev_time <= window
    | extend change_pct = (price_usd - prev_price) / prev_price * 100.0
    | where abs(change_pct) >= threshold_pct
    | extend
        alert_type = iff(change_pct > 0, "PRICE_SPIKE", "PRICE_DROP"),
        severity   = case(
            abs(change_pct) >= 10.0, "CRITICAL",
            abs(change_pct) >= 5.0,  "HIGH",
            abs(change_pct) >= 3.0,  "MEDIUM",
            "LOW")
    | project
        symbol,
        alert_type,
        triggered_at   = timestamp_utc,
        price_before   = prev_price,
        price_after    = price_usd,
        change_pct     = round(change_pct, 4),
        window_seconds = toint(totimespan(window) / 1s),
        severity
}

// Function: detect changes in Coinbase's rolling 24-hour volume snapshot.
// This is not per-window traded volume and is named separately to prevent that inference.
.create-or-alter function DetectVolume24hSnapshotChange(multiplier: real = 3.0, lookback: timespan = 5m) {
    let baseline =
        price_silver
        | where timestamp_utc between (ago(lookback + 1h) .. ago(lookback))
        | summarize baseline_snapshot_24h = avg(volume_24h) by symbol;
    price_silver
    | where timestamp_utc > ago(lookback)
    | summarize current_snapshot_24h = avg(volume_24h) by symbol
    | join kind=inner baseline on symbol
    | extend snapshot_ratio = current_snapshot_24h / baseline_snapshot_24h
    | where snapshot_ratio >= multiplier
    | extend severity = case(
        snapshot_ratio >= 10.0, "CRITICAL",
        snapshot_ratio >= 5.0,  "HIGH",
        snapshot_ratio >= 3.0,  "MEDIUM",
        "LOW")
    | project symbol, snapshot_ratio=round(snapshot_ratio, 2),
              current_snapshot_24h, baseline_snapshot_24h, severity
}

// Function: rolling volatility (std dev of log returns)
.create-or-alter function GetVolatility(lookback: timespan = 1h) {
    price_silver
    | where timestamp_utc > ago(lookback)
    | sort by symbol asc, timestamp_utc asc
    | serialize
    | extend
        prev_price  = prev(price_usd, 1),
        prev_symbol = prev(symbol, 1)
    | where symbol == prev_symbol and isnotnull(prev_price) and prev_price > 0
    | extend log_return = log(price_usd / prev_price)
    | summarize
        volatility_pct = round(stdev(log_return) * 100.0, 4),
        sample_count   = count(),
        price_range    = round(max(price_usd) - min(price_usd), 4)
      by symbol
    | order by volatility_pct desc
}

// Quick test queries
// DetectPriceSpikes(1.0, 60s)
// DetectVolume24hSnapshotChange(2.0, 10m)
// GetVolatility(1h)
